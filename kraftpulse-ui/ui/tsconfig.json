{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
    "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true
},
    "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}